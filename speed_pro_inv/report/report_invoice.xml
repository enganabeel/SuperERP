<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_speed_pro_invoice" model="report.paperformat">
        <field name="name">Speed Pro Invoice</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_speed_pro_invoice" model="ir.actions.report">
        <field name="name">Speed Pro Sales Tax Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">speed_pro_inv.report_invoice_document</field>
        <field name="print_report_name">'Sales Tax Invoice - %s' % (object.name or '')</field>
        <field name="paperformat_id" ref="paperformat_speed_pro_invoice"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
