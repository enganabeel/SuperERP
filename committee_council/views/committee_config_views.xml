    <record id="view_committee_review_authority_form" model="ir.ui.view">
        <field name="name">committee.review.authority.form</field>
        <field name="model">committee.review.authority</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="is_group"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Review Stages">
                            <field name="stage_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="manager_id"/>
                                    <field name="is_authority_manager"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_committee_review_authority" model="ir.actions.act_window">
        <field name="name">Review Authorities</field>
        <field name="res_model">committee.review.authority</field>
