    <!-- State classification (+ sub) -->
    <record id="view_committee_state_classification_list" model="ir.ui.view">
        <field name="name">committee.state.classification.list</field>
        <field name="model">committee.state.classification</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
