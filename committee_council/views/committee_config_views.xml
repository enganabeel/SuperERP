        <field name="name">committee.state.classification.form</field>
        <field name="model">committee.state.classification</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Sub-classifications">
                            <field name="sub_classification_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_committee_state_classification" model="ir.actions.act_window">
        <field name="name">Classification by Status</field>
        <field name="res_model">committee.state.classification</field>
        <field name="view_mode">list,form</field>
