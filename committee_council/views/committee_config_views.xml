    <!-- Minutes letter template -->
    <record id="view_committee_minutes_letter_template_list" model="ir.ui.view">
        <field name="name">committee.minutes.letter.template.list</field>
        <field name="model">committee.minutes.letter.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="applies_to"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_committee_minutes_letter_template_form" model="ir.ui.view">
        <field name="name">committee.minutes.letter.template.form</field>
        <field name="model">committee.minutes.letter.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="applies_to"/>
                        <field name="subject"/>
                        <field name="active"/>
                    </group>
                    <group string="Body">
                        <p class="text-muted">
                            Available placeholders: object.committee_id.name, object.minutes_number,
                            object.approval_transfer_date, object.review_notes, object.name
                        </p>
                        <field name="body" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_committee_minutes_letter_template" model="ir.actions.act_window">
        <field name="name">Minutes Letter Templates</field>
        <field name="res_model">committee.minutes.letter.template</field>
        <field name="view_mode">list,form</field>
    </record>

