    <!-- Review authority -->
    <record id="view_committee_review_authority_list" model="ir.ui.view">
        <field name="name">committee.review.authority.list</field>
        <field name="model">committee.review.authority</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="is_group"/>
