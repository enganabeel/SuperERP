<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_committee_committee_search" model="ir.ui.view">
        <field name="name">committee.committee.search</field>
        <field name="model">committee.committee</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="agency_id"/>
                <field name="manager_id"/>
                <field name="secretary_id"/>
                <filter string="Active" name="filter_active" domain="[('state', '=', 'active')]"/>
                <filter string="Archived" name="filter_archived" domain="[('state', '=', 'archived')]"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Agency" name="group_agency" context="{'group_by': 'agency_id'}"/>
                    <filter string="Importance" name="group_importance" context="{'group_by': 'importance_id'}"/>
                    <filter string="Periodicity" name="group_periodicity" context="{'group_by': 'periodicity_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_committee_committee_list" model="ir.ui.view">
        <field name="name">committee.committee.list</field>
        <field name="model">committee.committee</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="agency_id"/>
                <field name="manager_id"/>
                <field name="secretary_id"/>
                <field name="state_classification_id"/>
                <field name="write_date"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-muted="state == 'archived'" decoration-info="state == 'draft'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_committee_committee_kanban" model="ir.ui.view">
        <field name="name">committee.committee.kanban</field>
        <field name="model">committee.committee</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="agency_id"/>
                <field name="manager_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <div t-if="record.agency_id.raw_value"><field name="agency_id"/></div>
                        <div t-if="record.manager_id.raw_value"><field name="manager_id" widget="many2one_avatar_user"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_committee_committee_graph" model="ir.ui.view">
        <field name="name">committee.committee.graph</field>
        <field name="model">committee.committee</field>
        <field name="arch" type="xml">
            <graph type="pie" string="Committees">
                <field name="state" type="row"/>
            </graph>
        </field>
    </record>

    <record id="view_committee_committee_pivot" model="ir.ui.view">
        <field name="name">committee.committee.pivot</field>
        <field name="model">committee.committee</field>
        <field name="arch" type="xml">
            <pivot string="Committees">
                <field name="state" type="row"/>
                <field name="periodicity_id" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_committee_committee_form" model="ir.ui.view">
        <field name="name">committee.committee.form</field>
        <field name="model">committee.committee</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" string="Activate" type="object" class="btn-primary" invisible="state == 'active'"/>
                    <button name="action_archive_committee" string="Archive" type="object" invisible="state == 'archived'"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state == 'rejected'"/>
                    <button name="action_set_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,archived"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_meetings" icon="fa-calendar">
                            <field name="meeting_count" widget="statinfo" string="Meetings"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_minutes" icon="fa-file-text-o">
                            <field name="minutes_count" widget="statinfo" string="Minutes"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_decisions" icon="fa-gavel">
                            <field name="decision_count" widget="statinfo" string="Decisions"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_support_requests" icon="fa-life-ring">
                            <field name="support_request_count" widget="statinfo" string="Support Requests"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_tasks" icon="fa-tasks">
                            <field name="task_count" widget="statinfo" string="Tasks"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_transactions" icon="fa-exchange">
                            <field name="transaction_count" widget="statinfo" string="Transactions"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Committee name..."/></h1>
                        <h3><field name="code" readonly="1"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="agency_id"/>
                            <field name="manager_id"/>
                            <field name="temp_manager_id"/>
                            <field name="secretary_id"/>
                            <field name="representative_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="state_classification_id"/>
                            <field name="state_subclassification_id"/>
                            <field name="reference_classification_id"/>
                            <field name="importance_id"/>
                            <field name="secrecy_id"/>
                            <field name="specialty_id"/>
                            <field name="periodicity_id"/>
                            <field name="meeting_location_type_id"/>
                            <field name="membership_classification_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Current Topics">
                            <field name="topic_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="classification_id"/>
                                    <field name="topic_date"/>
                                    <field name="voting_end_date"/>
                                    <field name="vote_count"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Minutes">
                            <field name="minutes_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="meeting_id"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Members">
                            <field name="member_ids">
                                <list editable="bottom">
                                    <field name="user_id"/>
                                    <field name="role_id"/>
                                    <field name="agency_id"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tasks">
                            <field name="task_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="assigned_user_id"/>
                                    <field name="deadline"/>
                                    <field name="stage" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Verification Checklist">
                            <field name="verification_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="verified"/>
                                    <field name="verification_date"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Support Requests">
                            <field name="support_request_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="assigned_department"/>
                                    <field name="request_date"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Committee Status">
                            <field name="status_update_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="current_state"/>
                                    <field name="update_type"/>
                                    <field name="statement"/>
                                    <field name="user_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Transactions">
                            <field name="transaction_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="transaction_type"/>
                                    <field name="sender"/>
                                    <field name="recipient"/>
                                    <field name="transaction_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Decisions">
                            <field name="decision_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="recipient"/>
                                    <field name="stage"/>
                                </list>
                            </field>
                        </page>
                        <page string="Settings">
                            <group>
                                <group string="Review &amp; Adoption">
                                    <field name="review_authority_id"/>
                                    <field name="adoption_authority_id"/>
                                </group>
                                <group string="Visible Committee Actions">
                                    <field name="allow_member_assignment"/>
                                    <field name="allow_voting_control"/>
                                    <field name="allow_periodic_update"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_committee_committee" model="ir.actions.act_window">
        <field name="name">Committees</field>
        <field name="res_model">committee.committee</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
        <field name="search_view_id" ref="view_committee_committee_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first committee</p>
        </field>
    </record>

    <record id="action_committee_dashboard" model="ir.actions.act_window">
        <field name="name">Committees Dashboard</field>
        <field name="res_model">committee.committee</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="view_committee_committee_search"/>
    </record>

</odoo>
