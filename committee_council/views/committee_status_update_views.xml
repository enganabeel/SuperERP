<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_committee_status_update_list" model="ir.ui.view">
        <field name="name">committee.status.update.list</field>
        <field name="model">committee.status.update</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="committee_id"/>
                <field name="current_state"/>
                <field name="update_type"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_committee_status_update_form" model="ir.ui.view">
        <field name="name">committee.status.update.form</field>
        <field name="model">committee.status.update</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="committee_id"/>
                            <field name="current_state"/>
                            <field name="update_type"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <field name="statement" placeholder="Statement..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_committee_status_update" model="ir.actions.act_window">
        <field name="name">Committee Status Updates</field>
        <field name="res_model">committee.status.update</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
