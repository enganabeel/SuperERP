<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_committee_minutes_list" model="ir.ui.view">
        <field name="name">committee.minutes.list</field>
        <field name="model">committee.minutes</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="committee_id"/>
                <field name="meeting_id"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-info="state == 'review'"/>
            </list>
        </field>
    </record>

    <record id="view_committee_minutes_form" model="ir.ui.view">
        <field name="name">committee.minutes.form</field>
        <field name="model">committee.minutes</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send_for_review" string="Send for Review" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="state != 'review'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,review,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="committee_id"/>
                            <field name="meeting_id"/>
                            <field name="topic_ids" widget="many2many_tags"/>
                            <field name="letter_template_id"/>
                        </group>
                        <group>
                            <field name="review_authority_id"/>
                            <field name="adoption_authority_id"/>
                            <field name="approval_transfer_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Body">
                            <field name="body"/>
                        </page>
                        <page string="Recommendations">
                            <field name="recommendations"/>
                        </page>
                        <page string="Signatures">
                            <field name="signature_ids">
                                <list editable="bottom">
                                    <field name="user_id"/>
                                    <field name="signed"/>
                                    <field name="signed_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Review/Adoption Notes">
                            <field name="review_notes"/>
                            <field name="adoption_notes"/>
                        </page>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_committee_minutes" model="ir.actions.act_window">
        <field name="name">Minutes</field>
        <field name="res_model">committee.minutes</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
