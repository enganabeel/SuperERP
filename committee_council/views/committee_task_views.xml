<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_committee_task_list" model="ir.ui.view">
        <field name="name">committee.task.list</field>
        <field name="model">committee.task</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="committee_id"/>
                <field name="assigned_user_id"/>
                <field name="deadline"/>
                <field name="stage" widget="badge" decoration-success="stage == 'done'" decoration-info="stage == 'in_progress'"/>
            </list>
        </field>
    </record>

    <record id="view_committee_task_kanban" model="ir.ui.view">
        <field name="name">committee.task.kanban</field>
        <field name="model">committee.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage">
                <field name="name"/>
                <field name="assigned_user_id"/>
                <field name="deadline"/>
                <field name="priority"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <div><field name="assigned_user_id"/></div>
                        <div t-if="record.deadline.raw_value"><field name="deadline"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_committee_task_form" model="ir.ui.view">
        <field name="name">committee.task.form</field>
        <field name="model">committee.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="stage" widget="statusbar" statusbar_visible="new,in_progress,review,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Task name..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="committee_id"/>
                            <field name="assigned_user_id"/>
                        </group>
                        <group>
                            <field name="deadline"/>
                            <field name="priority"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_committee_task" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">committee.task</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>
