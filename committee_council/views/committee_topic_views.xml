<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_committee_topic_list" model="ir.ui.view">
        <field name="name">committee.topic.list</field>
        <field name="model">committee.topic</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="committee_id"/>
                <field name="topic_date"/>
                <field name="voting_end_date"/>
                <field name="vote_count"/>
                <field name="state" widget="badge" decoration-success="state == 'open'" decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="view_committee_topic_form" model="ir.ui.view">
        <field name="name">committee.topic.form</field>
        <field name="model">committee.topic</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_voting" string="Open Voting" type="object" class="btn-primary" invisible="state == 'open'"/>
                    <button name="action_close_voting" string="Close Voting" type="object" class="btn-secondary" invisible="state != 'open'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Topic title..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="committee_id"/>
                            <field name="agency_id"/>
                            <field name="admin_department"/>
                            <field name="classification_id"/>
                        </group>
                        <group>
                            <field name="topic_date"/>
                            <field name="voting_end_date"/>
                            <field name="vote_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Offer">
                            <field name="offer"/>
                        </page>
                        <page string="Grounds/Attachments">
                            <field name="grounds"/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Recommendations">
                            <field name="recommendations"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                        <page string="Votes">
                            <field name="vote_ids">
                                <list editable="bottom">
                                    <field name="member_id"/>
                                    <field name="answer_id"/>
                                    <field name="reason"/>
                                    <field name="vote_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_committee_topic" model="ir.actions.act_window">
        <field name="name">Committee Topics</field>
        <field name="res_model">committee.topic</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
