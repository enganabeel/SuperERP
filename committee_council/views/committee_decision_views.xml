<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_committee_decision_list" model="ir.ui.view">
        <field name="name">committee.decision.list</field>
        <field name="model">committee.decision</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="date"/>
                <field name="name"/>
                <field name="committee_id"/>
                <field name="recipient"/>
                <field name="stage"/>
            </list>
        </field>
    </record>

    <record id="view_committee_decision_form" model="ir.ui.view">
        <field name="name">committee.decision.form</field>
        <field name="model">committee.decision</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="committee_id"/>
                            <field name="meeting_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="recipient"/>
                            <field name="stage"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_committee_decision" model="ir.actions.act_window">
        <field name="name">Decisions</field>
        <field name="res_model">committee.decision</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
