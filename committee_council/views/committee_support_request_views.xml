<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_committee_support_request_list" model="ir.ui.view">
        <field name="name">committee.support.request.list</field>
        <field name="model">committee.support.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="committee_id"/>
                <field name="assigned_department"/>
                <field name="request_date"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'in_progress'"/>
            </list>
        </field>
    </record>

    <record id="view_committee_support_request_form" model="ir.ui.view">
        <field name="name">committee.support.request.form</field>
        <field name="model">committee.support.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="new,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Subject..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="committee_id"/>
                            <field name="assigned_department"/>
                        </group>
                        <group>
                            <field name="request_date"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_committee_support_request" model="ir.actions.act_window">
        <field name="name">Support Requests</field>
        <field name="res_model">committee.support.request</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
