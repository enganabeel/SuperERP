<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_news_carousel" name="News Carousel">
        <section class="s_afc_news" data-snippet="s_news_carousel" data-name="News Carousel">
            <div class="container">
                <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-3">
                    <div>
                        <span class="s_afc_section_label" contenteditable="true">Latest News</span>
                        <h2 class="mb-0" contenteditable="true">Stay up to date</h2>
                    </div>
                    <a href="/blog" class="btn btn-afc-outline">View all news</a>
                </div>

                <!--
                    Live posts from the Website Blog app (published, current
                    website, not scheduled in the future), newest first.
                    Falls back to 3 static placeholder cards below when no
                    blog posts exist yet (e.g. right after install) so the
                    section never renders empty.
                -->
                <t t-set="afc_news_posts" t-value="request.env['blog.post'].search(
                    request.env['website'].get_current_website().website_domain() + [('post_date', '&lt;=', datetime.datetime.now())],
                    order='post_date desc', limit=9)"/>

                <div id="afcNewsCarousel" class="carousel slide" data-bs-ride="false">
                    <div class="carousel-inner">
                        <t t-if="afc_news_posts">
                            <t t-foreach="range(0, len(afc_news_posts), 3)" t-as="afc_slide_start">
                                <div t-attf-class="carousel-item #{'active' if afc_slide_start == 0 else ''}">
                                    <div class="row g-4">
                                        <t t-foreach="afc_news_posts[afc_slide_start:afc_slide_start + 3]" t-as="afc_post">
                                            <div class="col-md-4">
                                                <t t-set="afc_cover" t-value="afc_post.cover_properties and json.loads(afc_post.cover_properties) or {}"/>
                                                <t t-set="afc_cover_img" t-value="afc_cover.get('background-image')"/>
                                                <a t-att-href="afc_post.website_url" class="s_afc_news_card">
                                                    <div class="s_afc_news_img"
                                                         t-attf-style="background-image:#{afc_cover_img if afc_cover_img and afc_cover_img != 'none' else &quot;url('/theme_afc2027/static/src/img/news-placeholder.jpg')&quot;};"/>
                                                    <div class="s_afc_news_body">
                                                        <span class="s_afc_news_date"
                                                              t-field="afc_post.post_date"
                                                              t-options="{'format': 'dd MMM yyyy'}"/>
                                                        <h5 t-field="afc_post.name"/>
                                                    </div>
                                                </a>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>
                        </t>
                        <t t-else="">
                            <div class="carousel-item active">
                                <div class="row g-4">
                                    <div class="col-md-4" t-foreach="3" t-as="dummy">
                                        <a href="#" class="s_afc_news_card">
                                            <div class="s_afc_news_img"
                                                 style="background-image:url('/theme_afc2027/static/src/img/news-placeholder.jpg')"/>
                                            <div class="s_afc_news_body">
                                                <span class="s_afc_news_date" contenteditable="true">
                                                    01 Jan 2026
                                                </span>
                                                <h5 contenteditable="true">
                                                    Sample news headline goes here
                                                </h5>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                    <t t-if="len(afc_news_posts) > 3">
                        <button class="carousel-control-prev" type="button"
                                data-bs-target="#afcNewsCarousel" data-bs-slide="prev">
                            <i class="fa fa-chevron-left text-white"/>
                        </button>
                        <button class="carousel-control-next" type="button"
                                data-bs-target="#afcNewsCarousel" data-bs-slide="next">
                            <i class="fa fa-chevron-right text-white"/>
                        </button>
                    </t>
                </div>
            </div>
        </section>
    </template>
</odoo>
