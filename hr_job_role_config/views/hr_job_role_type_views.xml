<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_job_role_type_list" model="ir.ui.view">
        <field name="name">hr.job.role.type.list</field>
        <field name="model">hr.job.role.type</field>
        <field name="arch" type="xml">
            <list string="Role Types" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_hr_job_role_type_form" model="ir.ui.view">
        <field name="name">hr.job.role.type.form</field>
        <field name="model">hr.job.role.type</field>
        <field name="arch" type="xml">
            <form string="Role Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_job_role_type" model="ir.actions.act_window">
        <field name="name">Role Types</field>
        <field name="res_model">hr.job.role.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_job_role_type"
              name="Role Types"
              parent="hr_recruitment.menu_hr_recruitment_config_jobs"
              action="action_hr_job_role_type"
              sequence="20"/>

</odoo>
