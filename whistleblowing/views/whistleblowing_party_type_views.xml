<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="whistleblowing_party_type_view_list" model="ir.ui.view">
        <field name="name">whistleblowing.party.type.list</field>
        <field name="model">whistleblowing.party.type</field>
        <field name="arch" type="xml">
            <list string="Party Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="whistleblowing_party_type_view_form" model="ir.ui.view">
        <field name="name">whistleblowing.party.type.form</field>
        <field name="model">whistleblowing.party.type</field>
        <field name="arch" type="xml">
            <form string="Party Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="whistleblowing_party_type_action" model="ir.actions.act_window">
        <field name="name">Party Types</field>
        <field name="res_model">whistleblowing.party.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first party type
            </p>
        </field>
    </record>

</odoo>
