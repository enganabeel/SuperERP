<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="whistleblowing_category_view_list" model="ir.ui.view">
        <field name="name">whistleblowing.category.list</field>
        <field name="model">whistleblowing.category</field>
        <field name="arch" type="xml">
            <list string="Incident Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="report_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="whistleblowing_category_view_form" model="ir.ui.view">
        <field name="name">whistleblowing.category.form</field>
        <field name="model">whistleblowing.category</field>
        <field name="arch" type="xml">
            <form string="Incident Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="whistleblowing_category_view_search" model="ir.ui.view">
        <field name="name">whistleblowing.category.search</field>
        <field name="model">whistleblowing.category</field>
        <field name="arch" type="xml">
            <search string="Search Incident Categories">
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="whistleblowing_category_action" model="ir.actions.act_window">
        <field name="name">Incident Categories</field>
        <field name="res_model">whistleblowing.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first incident category
            </p>
        </field>
    </record>

</odoo>
