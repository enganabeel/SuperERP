<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        "Positional Structure": org-chart view of Job Positions, structured
        by the "Reports To" field (parent_id/child_ids, added earlier in
        this module) rather than the department tree. Same org view type
        (from web_org) and card pattern as department_chart_types' own
        Departments Org Chart, adapted for hr.job: colored by hierarchy_level
        (depth in the Reports-To chain) via the computed chart_color_class,
        instead of department's dept_type, since jobs don't have an equivalent
        categorization to color by. chart_layout (Horizontal/Vertical) is
        its own field here, same as department's, so the per-node hanging
        layout still works. A position marked CEO Office (is_ceo_office)
        overrides its level color with the same grey used for a Committee
        department.
    -->
    <record id="hr_job_view_org" model="ir.ui.view">
        <field name="name">hr.job.view.org</field>
        <field name="model">hr.job</field>
        <field name="arch" type="xml">
            <org title_field="name"
                 parent_field="parent_id"
                 icon="fa-briefcase"
                 node_width="180"
                 node_height="65"
                 padding="12"
                 inverted="1"
                 layout_field="chart_layout"
                 link_type="default"
                 link_radius="0"
                 link_line_width="1">

                <field name="name"/>
                <field name="parent_id"/>
                <field name="no_of_employee"/>
                <field name="chart_layout"/>
                <field name="chart_color_class"/>
                <field name="is_ceo_office"/>
                <field name="needed_employees"/>

                <templates>
                    <t t-name="org-box">
                        <!--
                            Same record shape as the department card: field
                            values are read as record.data.<field>. Color
                            class is bound directly, same as department's
                            dept_color_class.
                        -->
                        <div t-att-data-select-node="record.data.id"
                             t-attf-class="o_org_job_card {{ record.data.is_ceo_office and 'o_org_job_ceo_office' or (record.data.chart_color_class or 'o_org_job_level_0') }} p-2 border rounded text-center shadow-sm h-100 d-flex flex-column justify-content-between">
                            <div class="o_org_job_head">
                                <div class="o_org_job_title fw-bold">
                                    <field name="name"/>
                                </div>
                            </div>
                            <div class="d-flex gap-1 justify-content-center align-items-center">
                                <t t-if="record.data.no_of_employee">
                                    <span class="badge o_org_job_badge" title="Employees in this position">
                                        <i class="fa fa-users me-1"/> <field name="no_of_employee"/>
                                    </span>
                                </t>
                                <t t-if="record.data.needed_employees &gt; 0">
                                    <span class="badge o_org_job_needed_badge" title="Additional employees needed to reach Target">
                                        <i class="fa fa-exclamation-circle me-1"/> <field name="needed_employees"/>
                                    </span>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </org>
        </field>
    </record>

    <record id="hr_job_action_org" model="ir.actions.act_window">
        <field name="name">Positional Structure</field>
        <field name="res_model">hr.job</field>
        <field name="view_mode">org,kanban,list,form</field>
        <field name="view_id" ref="hr_job_view_org"/>
    </record>

    <menuitem id="menu_hr_job_org"
              name="Positional Structure"
              parent="hr.hr_menu_hr_reports"
              action="hr_job_action_org"
              groups="hr.group_hr_user"
              sequence="61"/>

</odoo>
