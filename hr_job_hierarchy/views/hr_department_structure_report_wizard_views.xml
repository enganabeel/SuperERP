<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Wizard popup asking for one department (a Sector or any other
        one), then opens the SAME /department_structure_report HTML
        page (same CSS, same connectors, same colors) scoped to just
        that department. The controller's own child_of search already
        pulls in every descendant underneath whatever department it is
        given, so this is the exact same page, just pre-filtered.
    -->
    <record id="view_hr_department_structure_report_wizard_form" model="ir.ui.view">
        <field name="name">hr.department.structure.report.wizard.form</field>
        <field name="model">hr.department.structure.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Department Structure by Sector">
                <group>
                    <field name="department_id"/>
                </group>
                <footer>
                    <button string="Show" type="object" name="action_show_report" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_department_structure_report_wizard" model="ir.actions.act_window">
        <field name="name">Department Structure by Sector</field>
        <field name="res_model">hr.department.structure.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_hr_department_structure_report_wizard"
              name="Department Structure by Sector"
              parent="hr.hr_menu_hr_reports"
              action="action_hr_department_structure_report_wizard"
              groups="hr.group_hr_user"
              sequence="67"/>

</odoo>
